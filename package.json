{
  "name": "browse-ai-core-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "node scripts/build.mjs",
    "test": "npm run test:lib && npm run test:wrappers",
    "test:lib": "ng test browse-ai-core --no-watch",
    "test:wrappers": "vitest run --config vitest.wrappers.config.ts",
    "test:element": "node scripts/smoke-element.mjs",
    "check": "npm test && npm run build && npm run test:element",
    "npm-publish": "npm run check && npm publish ./dist/browse-ai-core",
    "prettier": "prettier --write . --ignore-unknown"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/elements": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "marked": "^18.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.45"
  }
}
